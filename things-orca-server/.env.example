# Optional: copy to ~/umbrel/app-data/things-orca-server/data/.env (chmod 600)
# to turn on the exit-node proxy (README, "Git hosts behind an exit node").
# Without TS_AUTHKEY the proxy stays off.

# Tailscale admin console -> Settings -> Keys -> Generate auth key
TS_AUTHKEY=
# The exit node's Tailscale device name (or 100.x IP)
EXIT_NODE=
