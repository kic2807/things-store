# Copy to ~/umbrel/app-data/things-subsy-cost/data/.env (chmod 600) and fill in.
# KEY=value per line, no quotes. Same keys as server/.env.example in
# github.com/kic2807/subsy-cost.

# ── App API token (Authorization: Bearer) ───────────
# openssl rand -hex 32
APP_TOKEN=

# ── Superset service account ─────────────────────────
SUPERSET_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_DATASET_ID=467
FULL_SYNC_START=2026-08-18

# ── Cloudflare ───────────────────────────────────────
# Zero Trust → Networks → Tunnels → (tunnel) → token from the Docker command
TUNNEL_TOKEN=
# https://<subdomain>.<domain> of the tunnel's public hostname (used in the setup QR)
PUBLIC_URL=
# Access service token. The server does not check these (Cloudflare Access does);
# they only go into the setup QR for the iOS app.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# LOG_LEVEL=debug
