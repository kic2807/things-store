#!/bin/bash
# orca-tailcat - the `tailcat` service of things-orca-server: reaches Orca's
# port 6768 from anywhere through a tailcat tunnel (Tailscale's data plane,
# no Tailscale account), without the Tailscale app on the client.
#
#   TAILCAT_ALLOW   comma-separated client node keys (the Mac's
#                   `nodekey:...`, README); unset = the service stays off
#   TAILCAT_PORT    the port to serve (default 6768)
#
# tailcat serves ports on its own localhost only, so the service runs in the
# server container's network namespace (network_mode: service:server) and
# reaches Orca on 127.0.0.1.
#
# The server key is saved under $HOME (app data), so the tailcat address
# stays the same across restarts; it is printed in the log and written to
# $HOME/address. Only the allowed keys can connect; Orca's pairing token is
# still needed on top.
set -u
log() { echo "orca-tailcat: $*"; }

# An empty --allow lets every client in: run only with at least one
# nodekey:..., spaces removed.
allow=$(printf '%s' "${TAILCAT_ALLOW:-}" | tr -d '[:space:]')
case ",$allow" in *,nodekey:?*) ;; *) allow="" ;; esac
if [ -z "$allow" ]; then
  log "off: set TAILCAT_ALLOW (the Mac's client key, nodekey:...) for this service to turn it on"
  trap 'exit 0' TERM INT
  while true; do sleep 3600 & wait $!; done
fi

if [ ! -f "$HOME/.config/tailcat/keys/default.private.json" ]; then
  log "creating the server key (the tailcat address)"
  tailcat genkey --key=default --fixed-region || { log "genkey failed"; exit 1; }
fi

port="${TAILCAT_PORT:-6768}"
log "serving $port (127.0.0.1:$port, the server's namespace)"
export TAILCAT_ADDR_FILE="$HOME/address"
exec tailcat serve --allow="$allow" "$port"
