{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode gzip
	# The UI calls /transmission/rpc on its own origin. Host is set to the
	# upstream's, as Radarr/Sonarr send it, so Transmission's host whitelist
	# accepts it however the page was opened.
	reverse_proxy /transmission/rpc {$TRANSMISSION:transmission_server_1:9091} {
		header_up Host {upstream_hostport}
	}
	root * /srv
	file_server
}
